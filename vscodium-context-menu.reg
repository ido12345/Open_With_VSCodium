Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\*\shell\Open with VSCodium]
@="Open with VSCodium"
"Icon"="C:\\Program Files\\VSCodium\\VSCodium.exe"

[HKEY_CURRENT_USER\Software\Classes\*\shell\Open with VSCodium\command]
@="\"C:\\Program Files\\VSCodium\\VSCodium.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Open with VSCodium]
@="Open with VSCodium"
"Icon"="C:\\Program Files\\VSCodium\\VSCodium.exe"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Open with VSCodium\command]
@="\"C:\\Program Files\\VSCodium\\VSCodium.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\Open with VSCodium]
@="Open with VSCodium"
"Icon"="C:\\Program Files\\VSCodium\\VSCodium.exe"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\Open with VSCodium\command]
@="\"C:\\Program Files\\VSCodium\\VSCodium.exe\" \"%V\""